{
  "schema": "lfsim-lab/design",
  "version": 1,
  "name": "RMI test rig \u2014 native firmware",
  "robot": {
    "name": "RMI test-rig line follower (profile only)",
    "wheelbase_mm": 140,
    "wheelDiameter_mm": 43,
    "wheelWidth_mm": 13,
    "length_mm": 165,
    "width_mm": 165,
    "axleFromFront_mm": 127,
    "sensorOffset_mm": 117,
    "casterOffset_mm": 70,
    "comOffset_mm": 15,
    "sensor": {
      "channels": 8,
      "spacing_mm": 15,
      "height_mm": 5.5,
      "spot_mm": 0,
      "adcBits": 12,
      "whiteRaw": 300,
      "blackRaw": 2600,
      "noise_pct": 1.5,
      "mismatch_pct": 8,
      "threshold": 1450
    },
    "motor": {
      "ratedV": 6,
      "noLoadRpm": 130,
      "stallTorque_kgcm": 0.35,
      "stallCurrent_A": 0.23,
      "gearRatio": 150,
      "mismatch_pct": 2
    },
    "driver": "TB6612FNG",
    "pwmFreq_Hz": 5000,
    "pwmBits": 10,
    "battery": {
      "fullV": 8.4,
      "nominalV": 7.4,
      "capacity_mAh": 850,
      "internalR_ohm": 0.15
    },
    "mass_g": 215,
    "inertia_kgm2": 0,
    "grip": 0.8,
    "encoders": {
      "present": true,
      "usedInCode": false,
      "cpr": 1050
    }
  },
  "settings": {},
  "plan": {
    "explore": {
      "name": "as flashed",
      "settings": {}
    },
    "memory": [
      {
        "name": "as flashed",
        "settings": {}
      }
    ],
    "dry_s": 300
  },
  "firmware": {
    "sources": [
      "../firmware/examples/rmi-test-rig/main/main.c"
    ],
    "wiring": "../firmware/examples/rmi-test-rig/main/wiring.json",
    "operator": {
      "each": {
        "presses": [
          {
            "gpio": 4,
            "at_s": 0.3
          },
          {
            "gpio": 4,
            "at_s": 3.8
          },
          {
            "gpio": 4,
            "at_s": 4.3
          }
        ],
        "sweep": {
          "from_s": 0.5,
          "to_s": 3.6
        }
      }
    }
  },
  "notes": "Your RMI firmware, unchanged. It keeps calibration in RAM, so the operator calibrates before every run (press, sweep, press to save, press to run). It has no maze memory and no switches yet, so every run explores."
}